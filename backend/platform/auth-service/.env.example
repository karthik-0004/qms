# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false
DATABASE_URL=postgresql+asyncpg://rainer:rainer_dev_password@localhost:5432/rainer_master
RAINER_MASTER_SECRET=change-me-in-production
REDIS_URL=redis://:rainer_redis_dev@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET_KEY=dev-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SERVICE_NAME=auth-service
PORT=8001

# ─── Dev bootstrap (optional) ────────────────────────────────────────────────
# Used by docker-compose init service to create/update a super admin.
# Do NOT use these defaults in production.
AUTH_SUPERADMIN_EMAIL=admin@rainertek.com
AUTH_SUPERADMIN_PASSWORD=RainerAdmin123!
