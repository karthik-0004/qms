# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false
DATABASE_URL=postgresql+asyncpg://rainer:CHANGE_ME_DB_PASSWORD@localhost:5432/rainer_master
RAINER_MASTER_SECRET=CHANGE_ME_IN_PRODUCTION
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AUTH_SERVICE_URL=http://localhost:8001
TENANT_SERVICE_URL=http://localhost:8002
SERVICE_NAME=user-service
PORT=8003

# ─── JWT (must match auth-service exactly — tokens are validated here) ────────
# IMPORTANT: This MUST be the same secret used by auth-service to sign tokens.
# Mismatch causes every request to return 401 Unauthorized.
JWT_SECRET_KEY=dev-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
