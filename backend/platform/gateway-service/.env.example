# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false

# Browser origins allowed to call the gateway (comma-separated). Add your LAN/public web URL if
# the app is not on localhost — otherwise the browser will block APIs with CORS errors.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Gateway → CCV upstreams ──────────────────────────────────────────────────
# In Docker Compose these default to Docker DNS names (crm-service:8040, …).
# If you run the gateway with `uvicorn` on your host while CCV containers publish ports:
# CRM_SERVICE_URL=http://127.0.0.1:8040
# CONTRACT_SERVICE_URL=http://127.0.0.1:8041
# WORKORDER_SERVICE_URL=http://127.0.0.1:8042
# TECHNICIAN_SERVICE_URL=http://127.0.0.1:8043
# BILLING_SERVICE_URL=http://127.0.0.1:8044
DATABASE_URL=postgresql+asyncpg://rainer:rainer_dev_password@localhost:5432/rainer_master
RAINER_MASTER_SECRET=change-me-in-production
REDIS_URL=redis://:rainer_redis_dev@localhost:6379/0
AUTH_SERVICE_URL=http://localhost:8001
# Tenant upstream: use localhost when gateway runs on the host (npm + uvicorn). The hostname
# `tenant-service` only resolves inside Docker Compose — on bare Windows it causes DNS errors
# (e.g. UPSTREAM_UNREACHABLE / "No address associated with hostname").
TENANT_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8005
CRM_SERVICE_URL=http://localhost:8040
CONTRACT_SERVICE_URL=http://localhost:8041
WORKORDER_SERVICE_URL=http://localhost:8042
TECHNICIAN_SERVICE_URL=http://localhost:8043
BILLING_SERVICE_URL=http://localhost:8044
JWT_SECRET_KEY=dev-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
SERVICE_NAME=gateway-service
PORT=8000
