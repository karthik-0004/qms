# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false
DATABASE_URL=postgresql+asyncpg://rainer:CHANGE_ME_DB_PASSWORD@localhost:5432/rainer_master
RAINER_MASTER_SECRET=CHANGE_ME_IN_PRODUCTION
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Email (SMTP) — required for tenant_admin_welcome and other outbound mail ─
# Local: use MailHog (docker compose exposes UI, SMTP on 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
# Use true for port 587 with STARTTLS (Gmail, SendGrid, etc.)
SMTP_START_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rainer.io
SMTP_FROM_NAME=Rainer Platform

SERVICE_NAME=notification-service
PORT=8005
