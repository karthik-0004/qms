# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false
DATABASE_URL=postgresql+asyncpg://rainer:CHANGE_ME_DB_PASSWORD@localhost:5432/rainer_master
RAINER_MASTER_SECRET=CHANGE_ME_IN_PRODUCTION
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET_KEY=YOUR_JWT_SECRET_MIN_32_CHARS_CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SERVICE_NAME=auth-service
PORT=8001

# ─── Dev bootstrap (optional) ────────────────────────────────────────────────
# Used by docker-compose init service to create/update a super admin.
# Do NOT use these defaults in production.
AUTH_SUPERADMIN_EMAIL=admin@rainertek.com
AUTH_SUPERADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Optional: create/update a tenant admin (requires tenant to exist in master DB)
# Populate these in your local `.env` (or container env) before running:
#   python -m app.scripts.create_tenant_admin
# or:
#   python -m app.scripts.seed_dev
AUTH_TENANTADMIN_EMAIL=
AUTH_TENANTADMIN_PASSWORD=
AUTH_TENANTADMIN_TENANT_ID=
AUTH_TENANTADMIN_ROLE=tenant_admin
