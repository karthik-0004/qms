#
# Frontend (Next.js) environment template
#
# Copy to `.env.local` for local development. Never commit `.env.local`.
#

# Required by NextAuth (v5 / Auth.js) to sign/encrypt cookies + JWT.
AUTH_SECRET="CHANGE_ME_NEXTAUTH_SECRET"

# Backend auth service base URL (used by Credentials provider).
# On the host (npm run dev), use http://localhost:8001 — not http://auth-service:8001 (Docker-only hostname).
AUTH_SERVICE_URL=""

# Platform gateway base URL (`:8000` in Docker). Used by server-side fetch and Next.js `rewrites()`
# targeting `/api/platform/*` → this host’s `/api/v1/*`. In the browser, `lib/api/client.ts` calls
# same-origin `/api/platform/...` so CRM/CCV/platform JSON calls always hit the gateway, not auth (:8001) by mistake.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# QMS: route all QMS HTTP clients through the same gateway as `NEXT_PUBLIC_API_URL` unless you intentionally
# bypass it for debugging. The gateway proxies `/api/v1/documents`, `/quality-events`, `/capas`, `/training`,
# `/equipment`, and `/analytics` to the respective services.
NEXT_PUBLIC_QMS_API_URL="http://localhost:8000"

# Optional per-service overrides (direct to microservice ports on the host). Normally leave unset so QMS
# traffic uses the gateway and one CORS origin.
# NEXT_PUBLIC_QMS_DOCUMENT_API_URL="http://localhost:8020"
# NEXT_PUBLIC_QMS_QUALITY_EVENT_API_URL="http://localhost:8021"
# NEXT_PUBLIC_QMS_CAPA_API_URL="http://localhost:8022"
# NEXT_PUBLIC_QMS_TRAINING_API_URL="http://localhost:8023"
# NEXT_PUBLIC_QMS_EQUIPMENT_API_URL="http://localhost:8024"

# If the gateway runs on your machine (not only in Docker), its own env must use host-reachable
# upstream URLs — e.g. `TENANT_SERVICE_URL=http://localhost:8002` in
# `backend/platform/gateway-service/.env`. Values like `http://tenant-service:8002` work only
# inside the compose network and break `/api/platform/tenants` from the browser on Windows.

# Optional: max wait (ms) for the server-side login request to auth-service (default 25000, min 3000, max 120000).
# AUTH_LOGIN_FETCH_TIMEOUT_MS="30000"

# Optional: client session helpers (`lib/api/session.ts`). Defaults: 5 minutes each.
# Fetch: max ms to wait on `/api/auth/session` (max 300000).
# NEXT_PUBLIC_SESSION_FETCH_TIMEOUT_MS="120000"
# Cache: ms to reuse session in memory after a successful fetch (max 1800000 = 30 min).
# NEXT_PUBLIC_SESSION_CACHE_TTL_MS="600000"
