# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false
DATABASE_URL=postgresql+asyncpg://rainer:CHANGE_ME_DB_PASSWORD@localhost:5432/rainer_master
RAINER_MASTER_SECRET=CHANGE_ME_IN_PRODUCTION
# Must match auth-service (same signing key as tokens you send). Defaults match auth-service code;
# docker-compose still sets a long dev-only JWT for auth + file-service; copy from compose or set your own.
JWT_SECRET_KEY=YOUR_JWT_SECRET_MIN_32_CHARS_CHANGE_ME
JWT_ALGORITHM=HS256
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=rainer_minio
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET
S3_BUCKET_NAME=rainer-files
SERVICE_NAME=file-service
PORT=8009
