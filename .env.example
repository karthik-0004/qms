# Copy to ".env" in this repo root. Docker Compose uses these for ${VAR:-default} substitution.
# Used by: notification-service (SMTP), tenant-service (welcome email login URL).

# Login URL embedded in new-tenant admin welcome emails (must match your web app URL)
PUBLIC_WEB_LOGIN_URL=http://localhost:3000/login

# --- SMTP (tenant admin credentials are emailed after create) ---
# Defaults in docker-compose.yml use MailHog (no auth) unless you override below.

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_START_TLS=false

# Auth (leave empty for MailHog). Prefer these names — they match docker-compose substitution.
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender shown to recipients (must be allowed by your provider)
SMTP_FROM_EMAIL=noreply@rainer.io
SMTP_FROM_NAME=Rainer Platform

# If you only set legacy names (SMTP_USER, SMTP_PASS, SMTP_FROM), docker-compose maps them into the container.
# Gmail: 2FA + App Password; spaces in the app password are stripped by notification-service.

# Example — typical provider (port 587 + STARTTLS):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=false
# SMTP_START_TLS=true
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# SMTP_FROM_EMAIL=noreply@yourcompany.com

# Example — implicit TLS (often port 465):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USE_TLS=true
# SMTP_START_TLS=false
