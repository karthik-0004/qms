# ─── Common ───────────────────────────────────────────────────────────────────
RAINER_ENV=development
LOG_LEVEL=DEBUG
JSON_LOGS=false
DATABASE_URL=postgresql+asyncpg://rainer:rainer_dev_password@localhost:5432/rainer_master
RAINER_MASTER_SECRET=change-me-in-production
REDIS_URL=redis://:rainer_redis_dev@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_ADMIN_URL=postgresql://rainer:rainer_dev_password@localhost:5432/postgres
# Must reach auth-service /api/v1/auth (defaults: docker DNS auth-service:8001; local: localhost:8001 or gateway 8000)
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8005
# Used in welcome email template as {{ login_url }} after tenant creation
PUBLIC_WEB_LOGIN_URL=http://localhost:3000/login
SERVICE_NAME=tenant-service
PORT=8002
